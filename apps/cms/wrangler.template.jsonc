// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the published wiring at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
//
// An OpenNext build on cloudflare-worker-turbo: `main` and `assets` are the
// adapter's outputs, so the composition's `wrangler deploy` ships both.
{
  "name": "multi-tenant-saas-2-cms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local" },
  "env": {
    "dev": {
      "vars": { "ENVIRONMENT": "dev" }
    },
    "stage": {
      "vars": { "ENVIRONMENT": "stage" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE_CMS", "id": "@@wiring(cloudflare-hyperdrive-cms/stage:hyperdrive_id)@@" }
      ]
    },
    "prod": {
      "vars": { "ENVIRONMENT": "prod" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE_CMS", "id": "@@wiring(cloudflare-hyperdrive-cms/prod:hyperdrive_id)@@" }
      ]
    }
  }
}
