{
  "name": "@saas/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3002",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'cms: lint runs in tests/cms'",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-r2": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.89.0",
    "pg": "8.20.0",
    "pg-cloudflare": "1.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250508.0",
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^7.0.3",
    "typescript": "5.7.3",
    "wrangler": "~4.116.0"
  }
}
